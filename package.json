{
  "name": "redress-backend",
  "version": "1.0.0",
  "description": "Redress AI-powered multi-vendor fashion marketplace backend",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prod": "node --import ./src/scripts/set-production-environment.js src/server.js",
    "build": "npm run openapi:check",
    "test": "node src/scripts/start-test-server.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "openapi:check": "node src/scripts/validate-openapi.js",
    "smoke:auth-profile": "node src/scripts/smoke-auth-profile.js",
    "smoke:catalog": "node src/scripts/smoke-catalog.js",
    "smoke:commerce": "node src/scripts/smoke-commerce.js",
    "db:migrate": "node src/database/migrate.js up",
    "db:migrate:undo": "node src/database/migrate.js down",
    "db:migrate:status": "node src/database/migrate.js status",
    "db:sync:dev": "node src/database/sync-dev.js",
    "db:seed:core": "node src/database/seed.js up",
    "db:seed:core:undo": "node src/database/seed.js down",
    "db:seed:core:status": "node src/database/seed.js status",
    "db:seed:catalog": "node src/database/seed-catalog.js up",
    "db:seed:catalog:undo": "node src/database/seed-catalog.js down",
    "db:seed:catalog:status": "node src/database/seed-catalog.js status",
    "db:seed:demo": "node src/database/seed-demo.js up",
    "db:seed:demo:undo": "node src/database/seed-demo.js down",
    "db:seed:demo:status": "node src/database/seed-demo.js status",
    "db:seed:home-feed:dev": "node src/scripts/seed-test-home-feed.js --environment=development",
    "db:seed:home-feed:test": "node src/scripts/seed-test-home-feed.js --environment=test",
    "storage:upload:home:dev": "node src/scripts/upload-home-placement-images.js --environment=development",
    "storage:upload:home:test": "node src/scripts/upload-home-placement-images.js --environment=test",
    "setup:home-feed:dev": "npm run storage:upload:home:dev && npm run db:seed:home-feed:dev",
    "setup:home-feed:test": "npm run storage:upload:home:test && npm run db:seed:home-feed:test",
    "storage:upload:starter": "node src/scripts/upload-starter-product-images.js",
    "storage:cleanup:body-photos": "node src/scripts/cleanup-unattached-body-photos.js",
    "db:seed:starter-products": "node src/scripts/seed-starter-products.js",
    "setup:starter-products": "npm run storage:upload:starter && npm run db:seed:starter-products"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.10",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.14",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "swagger-ui-dist": "^5.30.3",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "vitest": "^4.1.11"
  }
}